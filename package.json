{
  "name": "countries-and-resources",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cr/ui",
    "build": "npm run build -w @cr/ui",
    "preview": "npm run preview -w @cr/ui",
    "start": "npm run build && npm run preview -w @cr/ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/sim --noEmit && tsc -p packages/ui --noEmit && tsc -p tools --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "geodata": "tsx tools/geodata/build.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mapshaper": "^0.7.72",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
